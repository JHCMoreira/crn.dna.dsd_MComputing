<?xml version="1.0" encoding="UTF-8"?>
<!-- b6: conversionFactor no modelo e na especie.
     Esperado apos correcao: fator aplicado na conversao amount/concentration.
     Comportamento atual: atributo ignorado; S1 importa initialAmount cru como
     concentracao (ou sem o fator modelconv). -->
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="b6_conversion_factor" conversionFactor="modelconv">
    <listOfCompartments>
      <compartment id="compartment" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="S1" compartment="compartment" initialAmount="2" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false" conversionFactor="s1conv"/>
      <species id="S2" compartment="compartment" initialAmount="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="modelconv" value="0.5" constant="true"/>
      <parameter id="s1conv" value="2" constant="true"/>
      <parameter id="k" value="1" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="r1" reversible="false">
        <listOfReactants>
          <speciesReference species="S1" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="S2" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> k </ci>
              <ci> S1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
